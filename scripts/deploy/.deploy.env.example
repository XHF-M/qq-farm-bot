# 部署配置模板 —— 复制成 .deploy.env 后填写真实值
#
#   cp scripts/deploy/.deploy.env.example scripts/deploy/.deploy.env
#
# .deploy.env 已被 .gitignore 排除，不会进版本库。
# 也可以把它放在 .workbuddy/deploy/.deploy.env，脚本会自动回退到那里读。

# 服务器 SSH
SSH_HOST=1.2.3.4
SSH_USER=root
SSH_PASS=改成你的密码
SSH_PORT=22

# 服务器上的应用目录（git 仓库根）
APP_DIR=/root/docker/qq-farm-bot

# 跟随的分支
BRANCH=master

# 本机同步用的 git remote 名（填 remote 名，不是 URL）。
# origin 指向上游 liyangpengs（已停更），本地提交推的是 fork，
# 所以这里填自己的 fork remote，默认 fork。
GIT_REMOTE=fork
