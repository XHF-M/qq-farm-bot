# 复制为 .deploy.env 后按需修改；不存在的项用 deploy.sh 里的默认值
DOMAIN=farm.example.com
APP_DIR=/root/docker/qq-farm-bot
NGINX_DIR=/root/docker/nginx-gateway
NGINX_CONTAINER=nginx-gateway
APP_CONTAINER=qq-farm-bot
APP_PORT=3007
NETWORK=web-net
MEM_LIMIT=700m

# 访问认证（nginx Basic Auth）：默认关闭，面板本身已有登录密码
# 需要时置 true 并重跑 nginx 阶段，密码由 deploy.sh auth 生成
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=farm

# 80 端口是否被云厂商 ICP 拦截：auto 自动探测 / true 强制 TLS-ALPN-01 / false 用 HTTP-01
PORT80_BLOCKED=auto

GIT_REPO=https://github.com/liyangpengs/qq-farm-bot.git
NPM_REGISTRY=https://registry.npmmirror.com/
NODE_IMAGE=node:20-alpine
