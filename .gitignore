# Dependencies
node_modules/
bun.lock

# Build output
core/dist/
web/dist/
core/client.js

# Runtime data (contains user credentials and logs)
core/data/

# Debug/test scripts
core/scripts/

# Local captures, Spine source/renderer, and browser review artifacts
/output/
/.playwright-cli/

# Build analysis
web/stats.html

# Logs
*.log

# Runtime process state
*.pid
*.pid.lock

# Misc
core/share.txt
Update.log
*.tgz
*.tsbuildinfo

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Test/coverage
**/test/
**/tests/
!core/tests/
!core/tests/*.test.js
!web/tests/
!web/tests/*.test.mjs
coverage/
.nyc_output/

# Cleanup script (self-deleting)
cleanup.bat

# Local protocol captures and generated runtime analysis
protocol-captures/
/docs/performance-analysis/

# 资源嗅探代理生成的根证书与 URL 日志（仅本机使用，绝不入库）
/.capture/

# Python 字节码缓存（部署脚本 py_compile 会生成）
__pycache__/
*.pyc

/runtime/
/releases/
/packages/*/dist/
.turbo/

# WorkBuddy local workspace memory
.workbuddy/

# Local deploy credentials (never commit)
**/.deploy.env

# 本机启动脚本：各人环境不同，不入库。
# 也避免 redeploy.py 的 `git stash -u` 每次把它卷进 stash（中途失败可能丢本地改动）。
/start-local.bat
